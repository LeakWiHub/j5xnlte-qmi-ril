// SPDX-License-Identifier: Apache-2.0
// Place this project at external/j5xnlte-qmi-ril in a LineageOS 23.0 (Android 16) tree.
// Not built by the author: the Android build environment was not available (see README_RU.md, status table).

package {
    default_applicable_licenses: ["external_j5xnlte-qmi-ril_license"],
}

license {
    name: "external_j5xnlte-qmi-ril_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE"],
}

cc_defaults {
    name: "j5xnlte_ril_defaults",
    vendor: true,
    cflags: [
        "-Wall",
        "-Wextra",
    ],
}

// QMUX/QMI codec + transport + the synchronous "modem API". Plain C, no Android dependencies.
cc_library_static {
    name: "libj5xnlte_qmi",
    defaults: ["j5xnlte_ril_defaults"],
    srcs: [
        "qmi/src/qmi_codec.c",
        "qmi/src/qmi_dev.c",
        "qmi/src/qmi_log.c",
        "ril/core/ril_core.c",
        "ril/core/ril_svc_basic.c",
        "ril/core/ril_svc_ext.c",
    ],
    export_include_dirs: [
        "qmi/include",
        "ril/core",
    ],
}

// Radio AIDL V4 HAL (IRadioConfig, IRadioModem, IRadioSim, IRadioNetwork, IRadioMessaging, IRadioVoice, IRadioData).
// V4 is the highest frozen version the 202504 (Android 16) framework compatibility matrix accepts (radio.* = 3-4).
cc_binary {
    name: "android.hardware.radio-service.j5xnlte-qmi",
    defaults: ["j5xnlte_ril_defaults"],
    relative_install_path: "hw",
    // init rc and VINTF fragment for the "built into the image" path. The adb install path uses scripts/install.sh.
    init_rc: ["android/init.j5xnlte-ril.rc"],
    vintf_fragments: ["android/vintf/android.hardware.radio.j5xnlte-qmi.xml"],
    srcs: [
        "hal/src/hal_common.cc",
        "hal/src/radio_core.cc",
        "hal/src/radio_net.cc",
        "hal/src/main.cpp",
    ],
    local_include_dirs: [
        "hal/src",
        "hal/gen", // RadioXxxBase.h, generated by tools/gen-hal-base from the frozen V4 AIDL (checked in, CI checks freshness)
    ],
    cppflags: ["-std=c++20"],
    static_libs: [
        "libj5xnlte_qmi",
        "android.hardware.radio-V4-ndk",
        "android.hardware.radio.config-V4-ndk",
        "android.hardware.radio.data-V4-ndk",
        "android.hardware.radio.messaging-V4-ndk",
        "android.hardware.radio.modem-V4-ndk",
        "android.hardware.radio.network-V4-ndk",
        "android.hardware.radio.sim-V4-ndk",
        "android.hardware.radio.voice-V4-ndk",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
    ],
}

// Telephony feature flags, only needed when the vendor image does not declare them already.
prebuilt_etc {
    name: "j5xnlte-telephony-features",
    src: "android/permissions/android.hardware.telephony.j5xnlte.xml",
    sub_dir: "permissions",
    filename_from_src: true,
    vendor: true,
}
